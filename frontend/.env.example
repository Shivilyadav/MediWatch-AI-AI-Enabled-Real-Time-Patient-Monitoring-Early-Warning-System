# Set VITE_DEMO_MODE=true to use the frontend-only simulation engine (no backend required).
# Set VITE_DEMO_MODE=false (or leave unset) to connect to the real FastAPI backend.
VITE_DEMO_MODE=true

# Backend REST API base URL. The FastAPI server defaults to port 8021.
VITE_API_BASE_URL=http://localhost:8021

# Backend WebSocket URL. The telemetry endpoint is /ws/telemetry.
VITE_WS_URL=ws://localhost:8021/ws/telemetry
